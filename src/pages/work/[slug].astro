---
import Base from '../../layouts/Base.astro';
import DetailSubnav from '../../components/DetailSubnav.astro';
import UnlockDialog from '../../components/UnlockDialog.astro';
import { lockedBody } from '../../lib/locked-body';
import { getCollection, render } from 'astro:content';
import { srcsetFor, CONTENT_SIZES } from '../../lib/img';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => data.detail === true);
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.replace(/\.md$/, '');
const cipher = entry.data.locked ? await lockedBody(slug, entry.rendered?.html ?? '') : null;
---

<Base title={`Leigh Scholten: ${entry.data.title}`} description={entry.data.summary}>
  <DetailSubnav title={entry.data.title} context={entry.data.context} href="/" />

  <article class:list={['detail', { 'is-locked': cipher !== null }]} data-slug={slug} data-title={entry.data.title}>
    {entry.data.cover && (
      <picture>
        {entry.data.coverPhone && <source media="(max-width: 520px)" srcset={entry.data.coverPhone} />}
        <img
          class:list={['detail__hero', { 'detail__hero--square': entry.data.heroSquare }]} data-reveal
          src={entry.data.cover}
          srcset={srcsetFor(entry.data.cover)}
          sizes={CONTENT_SIZES}
          alt={entry.data.coverAlt ?? entry.data.title}
        />
      </picture>
    )}

    {/* data-wipe, not data-reveal-children: the body reveals as ONE group
        via the gradient wipe rather than per-child. Both are gated on
        html.is-js, so no-JS still renders it plainly visible. */}
    {cipher !== null ? (
      <div class="detail__body" id="details" data-wipe data-locked-body={cipher}></div>
    ) : (
      <div class="detail__body" id="details" data-wipe>
        <Content />
      </div>
    )}
  </article>

  {cipher !== null && <UnlockDialog />}
</Base>

<script>
  /* One script block, not two. Astro compiles each <script> separately and
     reorders them; split across two blocks the import below was dropped
     from the emitted module and the wipe threw ReferenceError at runtime. */
  import { wipeRevealVisible } from '../../lib/reveal';
  import { savedCode, openLockedBody, promptUnlock } from '../../lib/unlock';
  import { initPlaybackTape } from '../../lib/playback/loader';

  initPlaybackTape();

  /* Hero → body choreography (standalone case-study page).

     The body wipes in once the hero has finished its own reveal. The cue
     is the hero's transitionend, i.e. the existing animation's lifecycle
     — not a duplicated duration that would drift the moment anyone
     retimes revealOnLoad. */
  {
    const body = document.querySelector<HTMLElement>('.detail__body[data-wipe]');
    if (body && body.dataset.lockedBody === undefined) {
      const hero = document.querySelector<HTMLElement>('.detail__hero');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      let started = false;
      let failsafe = 0;
      const start = () => {
        if (started) return;
        started = true;
        window.clearTimeout(failsafe);
        hero?.removeEventListener('transitionend', onHeroEnd);

        // Each block wipes on its own — the ones already in view now, the
        // rest as they scroll up. One mask over the whole body would sweep
        // every image on the page at once.
        const blocks = Array.from(body.children) as HTMLElement[];
        wipeRevealVisible(body, blocks);
      };

      // The hero transitions both opacity and filter; only take the first.
      const onHeroEnd = (e: TransitionEvent) => {
        if (e.propertyName === 'opacity') start();
      };

      if (document.documentElement.classList.contains('settled')) {
        // Settled (reload, back/forward): the body is at rest. The CSS
        // drops the mask, so there's nothing to wipe.
        started = true;
      } else {
        // No hero (a case study without a cover), or reduced motion where
        // revealOnLoad resolves instantly and never fires a transition.
        if (!hero || reduce) start();
        else hero.addEventListener('transitionend', onHeroEnd);

        // Failsafe: the hero can be revealed without transitioning (the
        // 4s is-js escape hatch, a cached instant paint). Never strand the
        // body behind a mask waiting for an event that isn't coming.
        failsafe = window.setTimeout(start, 2200);
      }
    }
  }

  // Deep-link gate: a locked case study holds blurred, with its body still
  // encrypted, until the right code opens it. Dismissing returns home.
  {
    const art = document.querySelector<HTMLElement>('article.detail.is-locked');
    const body = art?.querySelector<HTMLElement>('[data-locked-body]');
    if (art && body) {
      const reveal = () => {
        art.classList.remove('is-locked');
        wipeRevealVisible(body, Array.from(body.children) as HTMLElement[]);
      };
      const slug = art.dataset.slug!;
      const code = savedCode(slug);
      (code ? openLockedBody(body, code) : Promise.resolve(false)).then((ok) => {
        if (ok) return reveal();
        promptUnlock({
          slug,
          title: art.dataset.title || 'this case study',
          verify: (c) => openLockedBody(body, c),
        }).then((opened) => (opened ? reveal() : location.assign('/')));
      });
    }
  }
</script>
