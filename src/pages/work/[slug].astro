---
import Base from '../../layouts/Base.astro';
import DetailSubnav from '../../components/DetailSubnav.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => data.detail === true);
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} — Leigh Scholten`} description={entry.data.summary}>
  <DetailSubnav title={entry.data.title} context={entry.data.context} href="/" />

  <article class="detail">
    {entry.data.cover && (
      <img
        class="detail__hero" data-reveal
        src={entry.data.cover}
        alt={entry.data.coverAlt ?? entry.data.title}
      />
    )}

    <div class="detail__body" id="details" data-reveal-children>
      <Content />
    </div>
  </article>
</Base>
